@@ -0,0 +1,43 @@
+// Adjustments for the current glitch-soc, on top of the stylesheet shipped by
+// Mastodon Modern.
+
+// Search results render their tab bar (and, on medium screens, a second search
+// form) inside the column header, which Modern pins into the navigation column
+// at a fixed 50px. Drop the duplicate form, make room for the 46px tab bar and
+// push the navigation menu down by the same amount.
+@media (min-width: 760px) {
+  .tabs-bar__wrapper:has(.account__section-headline) {
+    height: 96px !important;
+  }
+
+  .tabs-bar__wrapper .explore__search-header {
+    display: none;
+  }
+
+  .columns-area__panels:has(.tabs-bar__wrapper .account__section-headline)
+    .navigation-panel {
+    padding-top: calc(10px + var(--radius) + 46px);
+  }
+}
+
+// glitch-fixes keeps the blurhash preview visible at half opacity even after
+// the media has loaded, which only washes out the image.
+html[data-user-flavour='glitch']
+  #mastodon
+  .media-gallery__item
+  > .media-gallery__preview--hidden {
+  display: none;
+}
+
+// Modern stretches every settings label with a ::before over its whole row so
+// the row toggles its checkbox. In a radio group that lets the last option's
+// label cover its siblings, so only the last colour scheme, contrast or emoji
+// style could ever be picked.
+.admin-wrapper
+  .fields-group
+  .input.radio_buttons
+  .label_input__wrapper
+  .radio
+  > label::before {
+  content: none;
+}
